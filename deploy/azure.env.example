# Copy to /etc/plant-journal/azure.env, owned by root with mode 0600.
# Use systemd EnvironmentFile quoting for any whitespace, quotes, or backslashes.
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=plant-journal
AZURE_SQL_USERNAME=your-database-user
AZURE_SQL_PASSWORD=replace-with-your-password
