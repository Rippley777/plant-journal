# Copy to .env, fill in your values, then load it in your shell:
# set -a
# source .env
# set +a
# cargo run --locked -- --check-database
# cargo run --locked -- --migrate
# The application does not load .env automatically.
PLANT_CONFIG=config.toml
AZURE_SQL_SERVER='your-server.database.windows.net'
AZURE_SQL_DATABASE='plant-journal'
AZURE_SQL_USERNAME='your-database-user'
AZURE_SQL_PASSWORD='replace-with-your-password'
WEBSITES_ENABLE_APP_SERVICE_STORAGE=true
